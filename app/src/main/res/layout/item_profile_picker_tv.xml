<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:padding="8dp"
    android:stateListAnimator="@animator/item_season_tv_zoom">

    <FrameLayout
        android:id="@+id/fl_icon_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_item_profile_picker_tv"
        android:clipToOutline="true"
        android:foreground="@drawable/fg_item_profile_picker_tv"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_profile_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:padding="16dp"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_profile_blue" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_profile_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fl_icon_container"
        tools:text="Profile" />

    <TextView
        android:id="@+id/tv_profile_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_item_provider"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="12+"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btn_edit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@android:drawable/ic_menu_edit"
        android:tint="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/fl_icon_container"
        app:layout_constraintEnd_toStartOf="@id/btn_delete"
        app:layout_constraintStart_toStartOf="@id/fl_icon_container"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btn_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="#FF4444"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/fl_icon_container"
        app:layout_constraintEnd_toEndOf="@id/fl_icon_container"
        app:layout_constraintStart_toEndOf="@id/btn_edit"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
