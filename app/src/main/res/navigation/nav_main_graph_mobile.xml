<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main_graph_mobile"
    app:startDestination="@id/providers">

    <fragment
        android:id="@+id/providers"
        android:name="com.kflix.app.fragments.providers.ProvidersMobileFragment"
        android:label="fragment_providers_mobile"
        tools:layout="@layout/fragment_providers_mobile">
        <action
            android:id="@+id/action_providers_to_home"
            app:destination="@id/home"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>

    <!-- Global Actions -->
    <action
        android:id="@+id/action_global_providers"
        app:destination="@id/providers"
        app:enterAnim="@anim/nav_slide_in_right"
        app:exitAnim="@anim/nav_slide_out_left"
        app:popEnterAnim="@anim/nav_slide_in_left"
        app:popExitAnim="@anim/nav_slide_out_right" />
    <action
        android:id="@+id/action_global_profile_picker"
        app:destination="@id/profile_picker"
        app:enterAnim="@anim/nav_slide_in_right"
        app:exitAnim="@anim/nav_slide_out_left"
        app:popEnterAnim="@anim/nav_slide_in_left"
        app:popExitAnim="@anim/nav_slide_out_right" />
    <action
        android:id="@+id/action_global_player"
        app:destination="@id/player"
        app:enterAnim="@anim/nav_slide_in_right"
        app:exitAnim="@anim/nav_slide_out_left"
        app:popEnterAnim="@anim/nav_slide_in_left"
        app:popExitAnim="@anim/nav_slide_out_right" />
    <action
        android:id="@+id/action_global_tv_show"
        app:destination="@id/tv_show"
        app:enterAnim="@anim/nav_slide_in_right"
        app:exitAnim="@anim/nav_slide_out_left"
        app:popEnterAnim="@anim/nav_slide_in_left"
        app:popExitAnim="@anim/nav_slide_out_right" />
    <action
        android:id="@+id/action_global_movie"
        app:destination="@id/movie"
        app:enterAnim="@anim/nav_slide_in_right"
        app:exitAnim="@anim/nav_slide_out_left"
        app:popEnterAnim="@anim/nav_slide_in_left"
        app:popExitAnim="@anim/nav_slide_out_right" />

    <fragment
        android:id="@+id/home"
        android:name="com.kflix.app.fragments.home.HomeMobileFragment"
        android:label="fragment_home_mobile"
        tools:layout="@layout/fragment_home_mobile">
        <action
            android:id="@+id/action_home_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_home_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/search"
        android:name="com.kflix.app.fragments.search.SearchMobileFragment"
        android:label="fragment_search_mobile"
        tools:layout="@layout/fragment_search_mobile">
        <action
            android:id="@+id/action_search_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_search_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_search_to_genre"
            app:destination="@id/genre"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/movies"
        android:name="com.kflix.app.fragments.movies.MoviesMobileFragment"
        android:label="fragment_movies_mobile"
        tools:layout="@layout/fragment_movies_mobile">
        <action
            android:id="@+id/action_movies_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/tv_shows"
        android:name="com.kflix.app.fragments.tv_shows.TvShowsMobileFragment"
        android:label="fragment_tv_shows_mobile"
        tools:layout="@layout/fragment_tv_shows_mobile">
        <action
            android:id="@+id/action_tv_shows_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/movie"
        android:name="com.kflix.app.fragments.movie.MovieMobileFragment"
        android:label="fragment_movie_mobile"
        tools:layout="@layout/fragment_movie_mobile">
        <argument
            android:name="id"
            app:argType="string" />
        <action
            android:id="@+id/action_movie_to_player"
            app:destination="@id/player"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_movie_to_people"
            app:destination="@id/people"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_movie_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_movie_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/tv_show"
        android:name="com.kflix.app.fragments.tv_show.TvShowMobileFragment"
        android:label="fragment_tv_show_mobile"
        tools:layout="@layout/fragment_tv_show_mobile">
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="poster"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="banner"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_tv_show_to_season"
            app:destination="@id/season"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_tv_show_to_people"
            app:destination="@id/people"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_tv_show_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_tv_show_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_tv_show_to_player"
            app:destination="@id/player"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/season"
        android:name="com.kflix.app.fragments.season.SeasonMobileFragment"
        android:label="fragment_season_mobile"
        tools:layout="@layout/fragment_season_mobile">
        <action
            android:id="@+id/action_season_to_player"
            app:destination="@id/player"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <argument
            android:name="tvShowId"
            app:argType="string" />
        <argument
            android:name="tvShowTitle"
            app:argType="string" />
        <argument
            android:name="tvShowPoster"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="tvShowBanner"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="seasonId"
            app:argType="string" />
        <argument
            android:name="seasonNumber"
            app:argType="integer" />
        <argument
            android:name="seasonTitle"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/genre"
        android:name="com.kflix.app.fragments.genre.GenreMobileFragment"
        android:label="fragment_genre_mobile"
        tools:layout="@layout/fragment_genre_mobile">
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="name"
            app:argType="string" />
        <action
            android:id="@+id/action_genre_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_genre_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/people"
        android:name="com.kflix.app.fragments.people.PeopleMobileFragment"
        android:label="fragment_people_mobile"
        tools:layout="@layout/fragment_people_mobile">
        <argument
            android:name="id"
            app:argType="string" />
        <action
            android:id="@+id/action_people_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_people_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <argument
            android:name="name"
            app:argType="string" />
        <argument
            android:name="image"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/player"
        android:name="com.kflix.app.fragments.player.PlayerMobileFragment"
        android:label="fragment_player_mobile"
        tools:layout="@layout/fragment_player_mobile">
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="title"
            app:argType="string" />
        <argument
            android:name="subtitle"
            app:argType="string" />
        <argument
            android:name="videoType"
            app:argType="com.kflix.app.models.Video$Type" />
        <action
            android:id="@+id/action_playerMobileFragment_self"
            app:destination="@id/player"
            app:popUpTo="@id/player"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/library"
        android:name="com.kflix.app.fragments.library.LibraryMobileFragment"
        android:label="fragment_library_mobile"
        tools:layout="@layout/fragment_library_mobile">
        <action
            android:id="@+id/action_library_to_movie"
            app:destination="@id/movie"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
        <action
            android:id="@+id/action_library_to_tv_show"
            app:destination="@id/tv_show"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/settings"
        android:name="com.kflix.app.fragments.settings.SettingsMobileFragment"
        android:label="fragment_settings_mobile" >
        <action
            android:id="@+id/action_settings_to_settings_about"
            app:destination="@id/settings_about"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/settings_about"
        android:name="com.kflix.app.fragments.settings.about.SettingsAboutMobileFragment"
        android:label="fragment_settings_about_mobile" />

    <fragment
        android:id="@+id/profile_picker"
        android:name="com.kflix.app.fragments.profiles.ProfilePickerMobileFragment"
        android:label="fragment_profile_picker_mobile"
        tools:layout="@layout/fragment_profile_picker_mobile">
        <action
            android:id="@+id/action_profile_picker_to_home"
            app:destination="@id/home"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right"
            app:popUpTo="@id/providers"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
